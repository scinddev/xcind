#!/usr/bin/env bash
# xcind-run — Run declared bins and scripts in the app's Compose services
#
# Usage:
#   xcind-run [-T|--no-tty] <name> [args…]
#   xcind-run [-T] @exec <svc> [cmd…] | @run <svc> <cmd…> | @compose <args…>
#   xcind-run --list [--names]
#
# Bins come from XCIND_BINS (name:service[;key=value…]); scripts come from
# XCIND_SCRIPTS (name: followed by steps, one per line). Runner flags go
# before the name; everything after the name is passed to it.

set -euo pipefail

# Resolve XCIND_ROOT by following symlinks to the real install directory
# (npm, nix profile, and manual symlinks all route through here). macOS
# lacks `readlink -f`, so the resolver is a manual loop.
# Keep in sync with the equivalent stub in the other bin/ scripts.
__xcind_src="${BASH_SOURCE[0]}"
while [ -L "$__xcind_src" ]; do
  __xcind_src_dir=$(cd "$(dirname "$__xcind_src")" && pwd)
  __xcind_src=$(readlink "$__xcind_src")
  [[ $__xcind_src != /* ]] && __xcind_src="$__xcind_src_dir/$__xcind_src"
done
XCIND_ROOT="$(cd "$(dirname "$__xcind_src")/.." && pwd)"
unset __xcind_src __xcind_src_dir
# shellcheck disable=SC1091
source "$XCIND_ROOT/lib/xcind/xcind-bootstrap.bash"

__xcind_run_help() {
  cat <<'HELPEOF'
Usage: xcind-run [OPTIONS] <name> [args…]

Run a bin or script declared in .xcind.sh (XCIND_BINS / XCIND_SCRIPTS)
inside the app's Docker Compose services.

Options (before the name):
  -T, --no-tty   Pass -T to docker compose exec/run (also automatic when
                 stdin or stdout is not a terminal)
  --list         List runnable bins and scripts (names with a leading _
                 are hidden but stay runnable)
  --names        With --list: print bare names only, one per line
  --help, -h     Show this help
  --version, -V  Show version

The step keywords also work as the name:
  xcind-run @exec <svc> [cmd…]   docker compose exec (no cmd: bash)
  xcind-run @run <svc> <cmd…>    docker compose run --rm
  xcind-run @compose <args…>     docker compose, args verbatim

Examples:
  xcind-run npm --version
  xcind-run fresh
  xcind-run @exec app echo ok
  xcind-run @compose config --services
HELPEOF
}

# --- Flags (before the name) ---

__xcind_run_no_tty=0
__xcind_run_list=0
__xcind_run_names=0

while [[ $# -gt 0 ]]; do
  case $1 in
  -T | --no-tty)
    __xcind_run_no_tty=1
    shift
    ;;
  --list)
    __xcind_run_list=1
    shift
    ;;
  --names)
    __xcind_run_names=1
    shift
    ;;
  --help | -h)
    __xcind_run_help
    exit 0
    ;;
  --version | -V | --xcind-version)
    echo "xcind-run $(__xcind-version-string)"
    exit 0
    ;;
  --)
    shift
    break
    ;;
  -*)
    echo "xcind-run: unknown option '$1' (see xcind-run --help)" >&2
    exit 64
    ;;
  *)
    break
    ;;
  esac
done

if [[ $__xcind_run_names -eq 1 ]] && [[ $__xcind_run_list -eq 0 ]]; then
  echo "xcind-run: --names requires --list" >&2
  exit 64
fi

# Gentle nudge if jq/yq aren't on PATH (silent in scripts and CI).
__xcind-maybe-warn-deps

# --- Main ---

# Respect the GENERATE-hook TTL so repeated invocations stay cheap.
# Deliberately not exported: __xcind-prepare-app runs in this shell.
# shellcheck disable=SC2034 # read by __xcind-prepare-app in the sourced library
XCIND_PREPARE_USE_HOOKS_TTL=1

# Run the app-resolution pipeline (shared with xcind-compose/xcind-config).
__xcind-prepare-app || exit 1

# Parse bins and scripts; a name in both namespaces is a load-time error.
__xcind-runner-load || exit 1

if [[ $__xcind_run_list -eq 1 ]]; then
  __xcind-runner-list "$__xcind_run_names"
  exit 0
fi

if [[ $# -eq 0 ]]; then
  echo "xcind-run: missing name (see xcind-run --help or xcind-run --list)" >&2
  exit 64
fi

# Run EXECUTE hooks (not cached), like xcind-compose does
if [[ ${#XCIND_HOOKS_EXECUTE[@]} -gt 0 ]]; then
  __xcind-run-execute-hooks "$XCIND_APP_ROOT"
fi

# shellcheck disable=SC2034 # read by __xcind-runner-tty-opts in the sourced library
__XCIND_RUNNER_NO_TTY=$__xcind_run_no_tty

__xcind-runner-dispatch "$@"
