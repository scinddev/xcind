#!/usr/bin/env bash
# xcind-proxy — Manage shared Traefik proxy infrastructure
#
# Usage:
#   xcind-proxy init      Create proxy infrastructure files
#   xcind-proxy up        Start the shared Traefik proxy
#   xcind-proxy down      Stop the shared Traefik proxy
#   xcind-proxy status [--json]  Show proxy state
#   xcind-proxy logs      Show Traefik proxy logs

set -euo pipefail

# Resolve XCIND_ROOT by following symlinks to the real install directory
# (npm, nix profile, and manual symlinks all route through here). macOS
# lacks `readlink -f`, so the resolver is a manual loop.
# Keep in sync with the equivalent stub in the other bin/ scripts.
__xcind_src="${BASH_SOURCE[0]}"
while [ -L "$__xcind_src" ]; do
  __xcind_src_dir=$(cd "$(dirname "$__xcind_src")" && pwd)
  __xcind_src=$(readlink "$__xcind_src")
  [[ $__xcind_src != /* ]] && __xcind_src="$__xcind_src_dir/$__xcind_src"
done
XCIND_ROOT="$(cd "$(dirname "$__xcind_src")/.." && pwd)"
unset __xcind_src __xcind_src_dir
# shellcheck disable=SC1091
source "$XCIND_ROOT/lib/xcind/xcind-bootstrap.bash"

if [[ ${1:-} == "--version" ]] || [[ ${1:-} == "-V" ]]; then
  echo "xcind-proxy $(__xcind-version-string)"
  exit 0
fi

# --------------------------------------------------------------------------
# Subcommands (delegate to shared functions in xcind-proxy-lib.bash)
# --------------------------------------------------------------------------

__xcind-proxy-init() {
  # Parse init-specific flags
  local _flag_mode=""
  local _flag_network=""
  local _flag_http_entrypoint=""
  local _flag_https_entrypoint=""
  local _flag_certresolver=""
  local _flag_proxy_domain=""
  local _flag_http_port=""
  local _flag_image=""
  local _flag_dashboard=""
  local _flag_dashboard_port=""
  local _flag_tls_mode=""
  local _flag_https_port=""
  local _flag_tls_cert_file=""
  local _flag_tls_key_file=""

  __xcind-proxy-init-require-value() {
    if [[ $# -lt 2 ]]; then
      echo "Error: Missing value for init option: $1" >&2
      exit 1
    fi
  }

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --mode)
      __xcind-proxy-init-require-value "$@"
      _flag_mode="$2"
      shift 2
      ;;
    --network)
      __xcind-proxy-init-require-value "$@"
      _flag_network="$2"
      shift 2
      ;;
    --http-entrypoint)
      __xcind-proxy-init-require-value "$@"
      _flag_http_entrypoint="$2"
      shift 2
      ;;
    --https-entrypoint)
      __xcind-proxy-init-require-value "$@"
      _flag_https_entrypoint="$2"
      shift 2
      ;;
    --certresolver)
      __xcind-proxy-init-require-value "$@"
      _flag_certresolver="$2"
      shift 2
      ;;
    --proxy-domain)
      __xcind-proxy-init-require-value "$@"
      _flag_proxy_domain="$2"
      shift 2
      ;;
    --http-port)
      __xcind-proxy-init-require-value "$@"
      _flag_http_port="$2"
      shift 2
      ;;
    --image)
      __xcind-proxy-init-require-value "$@"
      _flag_image="$2"
      shift 2
      ;;
    --dashboard)
      __xcind-proxy-init-require-value "$@"
      _flag_dashboard="$2"
      shift 2
      ;;
    --dashboard-port)
      __xcind-proxy-init-require-value "$@"
      _flag_dashboard_port="$2"
      shift 2
      ;;
    --tls-mode)
      __xcind-proxy-init-require-value "$@"
      _flag_tls_mode="$2"
      shift 2
      ;;
    --https-port)
      __xcind-proxy-init-require-value "$@"
      _flag_https_port="$2"
      shift 2
      ;;
    --tls-cert-file)
      __xcind-proxy-init-require-value "$@"
      _flag_tls_cert_file="$2"
      shift 2
      ;;
    --tls-key-file)
      __xcind-proxy-init-require-value "$@"
      _flag_tls_key_file="$2"
      shift 2
      ;;
    --help | -h)
      __xcind-proxy-init-help
      exit 0
      ;;
    *)
      echo "Error: Unknown option for init: $1" >&2
      exit 1
      ;;
    esac
  done

  # Validate --mode value early — writing an invalid value into config.sh
  # would produce confusing downstream errors.
  if [[ -n $_flag_mode ]]; then
    case "$_flag_mode" in
    managed | external) ;;
    *)
      echo "Error: --mode must be 'managed' or 'external' (got: $_flag_mode)" >&2
      exit 1
      ;;
    esac
  fi

  # Validate --tls-mode value early — writing an invalid value into config.sh
  # would produce confusing downstream errors.
  if [[ -n $_flag_tls_mode ]]; then
    case "$_flag_tls_mode" in
    auto | custom | disabled) ;;
    *)
      echo "Error: --tls-mode must be 'auto', 'custom', or 'disabled' (got: $_flag_tls_mode)" >&2
      exit 1
      ;;
    esac
  fi

  # Validate port flags: must be positive integers in valid port range.
  __xcind-proxy-init-validate-port() {
    local flag="$1" val="$2"
    if ! [[ $val =~ ^[0-9]+$ ]] || [ "$val" -lt 1 ] || [ "$val" -gt 65535 ]; then
      echo "Error: $flag must be a port number between 1 and 65535 (got: $val)" >&2
      exit 1
    fi
  }
  [[ -n $_flag_http_port ]] && __xcind-proxy-init-validate-port "--http-port" "$_flag_http_port"
  [[ -n $_flag_https_port ]] && __xcind-proxy-init-validate-port "--https-port" "$_flag_https_port"
  [[ -n $_flag_dashboard_port ]] && __xcind-proxy-init-validate-port "--dashboard-port" "$_flag_dashboard_port"

  # Validate --dashboard: must be 'true' or 'false'.
  if [[ -n $_flag_dashboard ]]; then
    case "$_flag_dashboard" in
    true | false) ;;
    *)
      echo "Error: --dashboard must be 'true' or 'false' (got: $_flag_dashboard)" >&2
      exit 1
      ;;
    esac
  fi

  mkdir -p "$XCIND_PROXY_CONFIG_DIR" "$XCIND_PROXY_STATE_DIR"

  # Source existing config if present (provides current values as defaults)
  if [[ -f "$XCIND_PROXY_CONFIG_DIR/config.sh" ]]; then
    # shellcheck disable=SC1091
    source "$XCIND_PROXY_CONFIG_DIR/config.sh"
  fi

  # Apply CLI flag overrides (variables consumed by __xcind-proxy-write-config)
  # shellcheck disable=SC2034
  [[ -n $_flag_mode ]] && XCIND_PROXY_MODE="$_flag_mode"
  # shellcheck disable=SC2034
  [[ -n $_flag_network ]] && XCIND_PROXY_NETWORK="$_flag_network"
  # shellcheck disable=SC2034
  [[ -n $_flag_http_entrypoint ]] && XCIND_PROXY_HTTP_ENTRYPOINT="$_flag_http_entrypoint"
  # shellcheck disable=SC2034
  [[ -n $_flag_https_entrypoint ]] && XCIND_PROXY_HTTPS_ENTRYPOINT="$_flag_https_entrypoint"
  # shellcheck disable=SC2034
  [[ -n $_flag_certresolver ]] && XCIND_PROXY_CERTRESOLVER="$_flag_certresolver"
  # shellcheck disable=SC2034
  [[ -n $_flag_proxy_domain ]] && XCIND_PROXY_DOMAIN="$_flag_proxy_domain"
  # shellcheck disable=SC2034
  [[ -n $_flag_http_port ]] && XCIND_PROXY_HTTP_PORT="$_flag_http_port"
  # shellcheck disable=SC2034
  [[ -n $_flag_image ]] && XCIND_PROXY_IMAGE="$_flag_image"
  # shellcheck disable=SC2034
  [[ -n $_flag_dashboard ]] && XCIND_PROXY_DASHBOARD="$_flag_dashboard"
  # shellcheck disable=SC2034
  [[ -n $_flag_dashboard_port ]] && XCIND_PROXY_DASHBOARD_PORT="$_flag_dashboard_port"
  # shellcheck disable=SC2034
  [[ -n $_flag_tls_mode ]] && XCIND_PROXY_TLS_MODE="$_flag_tls_mode"
  # shellcheck disable=SC2034
  [[ -n $_flag_https_port ]] && XCIND_PROXY_HTTPS_PORT="$_flag_https_port"
  # shellcheck disable=SC2034
  [[ -n $_flag_tls_cert_file ]] && XCIND_PROXY_TLS_CERT_FILE="$_flag_tls_cert_file"
  # shellcheck disable=SC2034
  [[ -n $_flag_tls_key_file ]] && XCIND_PROXY_TLS_KEY_FILE="$_flag_tls_key_file"

  # Cross-validate the *effective* (merged) values for external mode.
  if [[ ${XCIND_PROXY_MODE:-managed} == "external" ]]; then
    # custom TLS configures file-based certs xcind never provisions in
    # external mode — accepting it would guarantee a broken setup.
    if [[ ${XCIND_PROXY_TLS_MODE:-auto} == "custom" ]]; then
      echo "Error: --tls-mode custom cannot be combined with external proxy mode." >&2
      echo "The external proxy terminates TLS; use --tls-mode auto (emit HTTPS routers)" >&2
      echo "or disabled (HTTP-only routers), and configure certificates on the proxy itself." >&2
      exit 1
    fi
    # Managed-only flags are persisted (they apply again after switching back
    # to managed mode) but have no effect while external.
    local _managed_flag
    for _managed_flag in \
      "--image:$_flag_image" \
      "--dashboard:$_flag_dashboard" \
      "--dashboard-port:$_flag_dashboard_port" \
      "--http-port:$_flag_http_port" \
      "--https-port:$_flag_https_port" \
      "--tls-cert-file:$_flag_tls_cert_file" \
      "--tls-key-file:$_flag_tls_key_file"; do
      if [[ -n ${_managed_flag#*:} ]]; then
        echo "Warning: ${_managed_flag%%:*} has no effect in external mode; value saved for managed mode." >&2
      fi
    done
  fi

  # Write config (always — merges existing + overrides)
  __xcind-proxy-write-config

  # Run full init (sources config, generates compose/traefik, creates network)
  __xcind-proxy-ensure-init

  echo "Proxy config at $XCIND_PROXY_CONFIG_DIR"
  if __xcind-proxy-is-external; then
    echo "Proxy mode: external — xcind will attach apps to network '$XCIND_PROXY_NETWORK'"
    echo "  Entrypoints: $XCIND_PROXY_HTTP_ENTRYPOINT / $XCIND_PROXY_HTTPS_ENTRYPOINT"
    echo "  Certresolver: ${XCIND_PROXY_CERTRESOLVER:-none}"
    # Migration hint: a previously managed Traefik may still hold ports 80/443.
    local _leftover
    _leftover=$(docker ps --filter label=xcind.component=proxy --filter status=running -q 2>/dev/null) || true
    if [[ -n $_leftover ]]; then
      echo "Warning: a xcind-managed Traefik proxy is still running." >&2
      echo "         Stop it with: xcind-proxy down" >&2
    fi
  else
    echo "Generated files at $XCIND_PROXY_STATE_DIR"
  fi
}

__xcind-proxy-up() {
  local force=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --force)
      force=true
      shift
      ;;
    -*)
      echo "Error: Unknown option for up: $1" >&2
      exit 1
      ;;
    *)
      echo "Error: Unexpected argument for up: $1" >&2
      exit 1
      ;;
    esac
  done

  if __xcind-proxy-is-external; then
    if [[ $force == true ]]; then
      echo "Error: 'up --force' is not available in external proxy mode." >&2
      echo "Network '$XCIND_PROXY_NETWORK' is shared with the external proxy and will not be removed." >&2
      exit 1
    fi
    # "up" in external mode means: verify the shared network is in place.
    __xcind-proxy-ensure-network || exit 1
    echo "Proxy is externally managed — nothing to start."
    echo "Network: $XCIND_PROXY_NETWORK"
    local detected=""
    detected=$(__xcind-proxy-detect-external-container) || true
    if [[ -n $detected ]]; then
      echo "Proxy container: $detected (detected)"
    else
      echo "Warning: no proxy-like container detected on network '$XCIND_PROXY_NETWORK'." >&2
    fi
    return 0
  fi

  if [[ $force == true ]]; then
    # Tear down existing containers so the network can be recreated
    docker compose -f "$XCIND_PROXY_COMPOSE" down 2>/dev/null || true
    docker network rm "$XCIND_PROXY_NETWORK" 2>/dev/null || true
  fi

  # Always regenerate files from current config.sh
  __xcind-proxy-ensure-init

  if [ "$force" = true ]; then
    docker compose -f "$XCIND_PROXY_COMPOSE" up -d || return $?
  else
    # Start if not already running; strict=true so explicit CLI up propagates
    # docker compose failures instead of silently swallowing them.
    XCIND_PROXY_AUTO_START=1 __xcind-proxy-ensure-running strict
  fi
}

__xcind-proxy-down() {
  if [[ $# -gt 0 ]]; then
    echo "Error: Unexpected argument for down: $1" >&2
    exit 1
  fi

  if __xcind-proxy-is-external; then
    # Migration escape hatch: stop a leftover xcind-managed Traefik that is
    # still running from before the switch to external mode.
    local leftover
    leftover=$(docker ps --filter label=xcind.component=proxy --filter status=running -q 2>/dev/null) || true
    if [[ -n $leftover && -f $XCIND_PROXY_COMPOSE ]]; then
      docker compose -f "$XCIND_PROXY_COMPOSE" down
      return 0
    fi
    echo "Error: proxy is externally managed — xcind will not stop it." >&2
    exit 1
  fi

  local compose_file="$XCIND_PROXY_COMPOSE"

  # Fallback for pre-migration installs. Checked in ascending-recency
  # order so the newest legacy location wins when multiple are present.
  #   1. state dir / docker-compose.yaml — pre-rename install (<= v0.5)
  #   2. config dir / docker-compose.yaml — pre-config/state split install
  if [ ! -f "$compose_file" ]; then
    if [ -f "$XCIND_PROXY_STATE_DIR/docker-compose.yaml" ]; then
      compose_file="$XCIND_PROXY_STATE_DIR/docker-compose.yaml"
    elif [ -f "$XCIND_PROXY_CONFIG_DIR/docker-compose.yaml" ]; then
      compose_file="$XCIND_PROXY_CONFIG_DIR/docker-compose.yaml"
    fi
  fi

  if [ ! -f "$compose_file" ]; then
    echo "Proxy not initialized. Run 'xcind-proxy init' to set up proxy infrastructure." >&2
    exit 1
  fi

  docker compose -f "$compose_file" down
}

__xcind-proxy-dispose() {
  local purge=false
  local yes=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --purge)
      purge=true
      shift
      ;;
    --yes | -y)
      yes=true
      shift
      ;;
    --help | -h)
      echo "Usage: xcind-proxy dispose [OPTIONS]"
      echo ""
      echo "Stop the shared Traefik proxy, remove the xcind-proxy network, and"
      echo "remove generated proxy state. Keeps config.sh unless --purge."
      echo ""
      echo "Options:"
      echo "  --purge        Also remove ~/.config/xcind/proxy (config.sh)"
      echo "  --yes, -y      Skip the confirmation prompt"
      return 0
      ;;
    -*)
      echo "Error: Unknown option for dispose: $1" >&2
      return 1
      ;;
    *)
      echo "Error: Unexpected argument for dispose: $1" >&2
      return 1
      ;;
    esac
  done

  # Decide what is actually left to do before prompting, so an already
  # disposed proxy never asks the user to confirm a no-op.
  local proxy_present=true
  [[ -f $XCIND_PROXY_COMPOSE ]] || proxy_present=false
  local config_present=true
  [[ -d $XCIND_PROXY_CONFIG_DIR ]] || config_present=false
  local external=false
  __xcind-proxy-is-external && external=true

  if [[ $proxy_present == false && ($purge != true || $config_present == false) ]]; then
    echo "Proxy already disposed."
    return 0
  fi

  if [[ $yes != true ]]; then
    local prompt="Dispose proxy:"
    if [[ $proxy_present == true ]]; then
      local assignment_count=0
      if [[ -f $XCIND_ASSIGNED_PORTS_FILE ]]; then
        assignment_count=$(awk 'NF && $1 !~ /^#/ { count++ } END { print count + 0 }' "$XCIND_ASSIGNED_PORTS_FILE")
      fi
      if [[ $external == true ]]; then
        prompt+=$'\n'"  - stop a leftover xcind-managed proxy, if one is running"
      else
        prompt+=$'\n'"  - stop the managed proxy"
        prompt+=$'\n'"  - remove Docker network $XCIND_PROXY_NETWORK"
      fi
      prompt+=$'\n'"  - remove generated state $XCIND_PROXY_STATE_DIR"
      [[ $assignment_count -gt 0 ]] && prompt+=$'\n'"  - forget $assignment_count assigned-port binding(s); apps receive new ports on next up"
    fi
    [[ $purge == true ]] && prompt+=$'\n'"  - remove configuration $XCIND_PROXY_CONFIG_DIR (--purge)"
    __xcind-confirm "$prompt" || return 1
  fi

  if [[ $proxy_present == true ]]; then
    # An external-mode config can retain compose.yaml while a former
    # xcind-managed proxy is still running. Stop that known leftover before
    # removing its state. Never remove the shared network in external mode —
    # it belongs to the external proxy, not to xcind.
    local stop_err="Error: Could not stop the proxy compose project."
    [[ $external == true ]] && stop_err="Error: Could not stop the retained xcind-managed proxy."
    if ! docker compose -f "$XCIND_PROXY_COMPOSE" down; then
      echo "$stop_err" >&2
      return 1
    fi

    if [[ $external != true ]]; then
      local network_err=""
      if ! network_err=$(docker network rm "$XCIND_PROXY_NETWORK" 2>&1); then
        if [[ $network_err != *"No such network"* && $network_err != *"not found"* ]]; then
          printf '%s\n' "$network_err" >&2
          echo "Error: Could not remove proxy network $XCIND_PROXY_NETWORK; apps may still be attached." >&2
          return 1
        fi
      fi
    fi

    if ! rm -rf "$XCIND_PROXY_STATE_DIR"; then
      echo "Error: Could not remove generated state $XCIND_PROXY_STATE_DIR." >&2
      return 1
    fi
  fi

  if [[ $purge == true ]]; then
    if ! rm -rf "$XCIND_PROXY_CONFIG_DIR"; then
      echo "Error: Could not remove configuration $XCIND_PROXY_CONFIG_DIR." >&2
      return 1
    fi
  fi

  if [[ $proxy_present == true ]]; then
    echo "Proxy disposed."
  else
    echo "Proxy configuration removed."
  fi
}

__xcind-proxy-status() {
  local json_mode=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --json)
      json_mode=true
      shift
      ;;
    -*)
      echo "Error: Unknown option for status: $1" >&2
      exit 1
      ;;
    *)
      echo "Error: Unexpected argument for status: $1" >&2
      exit 1
      ;;
    esac
  done

  # jq is required for --json output (the hand-rolled printf template used
  # to be tolerant of missing jq, but since the output is now built with
  # `jq -n`, fail loudly instead of producing broken JSON).
  if [[ $json_mode == true ]] && ! command -v jq &>/dev/null; then
    echo "Error: jq is required for --json output." >&2
    exit 1
  fi

  # Config was loaded at dispatch; external mode renders its own report
  # (there is no managed compose file or Traefik container to inspect).
  if __xcind-proxy-is-external; then
    __xcind-proxy-status-external "$json_mode"
    return 0
  fi

  # Not initialized
  if [ ! -f "$XCIND_PROXY_COMPOSE" ]; then
    if [ "$json_mode" = true ]; then
      jq -cn '{initialized: false, mode: "managed", status: "not_initialized", assigned_ports: []}'
    else
      echo "Status: not initialized"
      echo "Run 'xcind-proxy init' to set up proxy infrastructure."
      __xcind-proxy-status-assigned-text
    fi
    return 0
  fi

  # Check if running
  local running_raw
  running_raw=$(docker compose -f "$XCIND_PROXY_COMPOSE" ps --format json 2>/dev/null | head -1) || true
  local running_status="stopped"
  if [ -n "$running_raw" ]; then
    running_status="running"
  fi

  # Check config staleness
  local config_status="current"
  if [[ -f "$XCIND_PROXY_CONFIG_DIR/config.sh" && -f $XCIND_PROXY_COMPOSE ]] &&
    [[ "$XCIND_PROXY_CONFIG_DIR/config.sh" -nt $XCIND_PROXY_COMPOSE ]]; then
    config_status="stale"
  fi

  local image="${XCIND_PROXY_IMAGE:-traefik:v3}"
  local http_port="${XCIND_PROXY_HTTP_PORT:-80}"
  local tls_mode="${XCIND_PROXY_TLS_MODE:-auto}"
  local https_port="${XCIND_PROXY_HTTPS_PORT:-443}"
  local tls_enabled=true
  [[ $tls_mode == "disabled" ]] && tls_enabled=false
  local dashboard_enabled=false
  local dashboard_url=""
  if [ "${XCIND_PROXY_DASHBOARD:-false}" = "true" ]; then
    dashboard_enabled=true
    dashboard_url="http://localhost:${XCIND_PROXY_DASHBOARD_PORT:-8080}"
  fi

  local network_name="$XCIND_PROXY_NETWORK"
  local network_exists=false
  if docker network inspect "$XCIND_PROXY_NETWORK" &>/dev/null; then
    network_exists=true
  fi

  # Output
  if [ "$json_mode" = true ]; then
    local assigned_json
    assigned_json=$(__xcind-proxy-status-assigned-json)
    jq -cn \
      --arg status "$running_status" \
      --arg config "$config_status" \
      --arg image "$image" \
      --argjson http_port "$http_port" \
      --arg tls_mode "$tls_mode" \
      --argjson tls_enabled "$tls_enabled" \
      --argjson https_port "$https_port" \
      --argjson dashboard_enabled "$dashboard_enabled" \
      --arg dashboard_url "$dashboard_url" \
      --arg network_name "$network_name" \
      --argjson network_exists "$network_exists" \
      --arg http_entrypoint "$XCIND_PROXY_HTTP_ENTRYPOINT" \
      --arg https_entrypoint "$XCIND_PROXY_HTTPS_ENTRYPOINT" \
      --arg certresolver "$XCIND_PROXY_CERTRESOLVER" \
      --argjson assigned_ports "$assigned_json" \
      '{
        initialized: true,
        mode: "managed",
        status: $status,
        config: $config,
        image: $image,
        http_port: $http_port,
        tls_mode: $tls_mode,
        tls_enabled: $tls_enabled,
        https_port: $https_port,
        dashboard_enabled: $dashboard_enabled,
        dashboard_url: $dashboard_url,
        network_name: $network_name,
        network_exists: $network_exists,
        http_entrypoint: $http_entrypoint,
        https_entrypoint: $https_entrypoint,
        certresolver: $certresolver,
        assigned_ports: $assigned_ports
      }'
  else
    echo "Status: $running_status"
    echo "Mode: managed"
    if [ "$config_status" = "stale" ]; then
      echo "Config: stale (run 'xcind-proxy up' to regenerate)"
    else
      echo "Config: current"
    fi
    echo "Image: $image"
    echo "HTTP port: $http_port"
    echo "TLS mode: $tls_mode"
    if [ "$tls_enabled" = true ]; then
      echo "HTTPS port: $https_port"
    fi
    if [ "$dashboard_enabled" = true ]; then
      echo "Dashboard: $dashboard_url"
    fi
    if [ "$network_exists" = true ]; then
      echo "Network: $network_name (exists)"
    else
      echo "Network: $network_name (missing)"
    fi
    __xcind-proxy-status-assigned-text
  fi
}

# Render `xcind-proxy status` for external proxy mode. There is no managed
# container to inspect; report the shared network, label configuration, and
# a best-effort detection of the external proxy container.
__xcind-proxy-status-external() {
  local json_mode="$1"

  local initialized=false
  [ -f "$XCIND_PROXY_CONFIG_DIR/config.sh" ] && initialized=true

  local network_exists=false
  if docker network inspect "$XCIND_PROXY_NETWORK" &>/dev/null; then
    network_exists=true
  fi

  local proxy_container=""
  proxy_container=$(__xcind-proxy-detect-external-container) || true

  local domain="${XCIND_PROXY_DOMAIN:-localhost.scind.io}"
  local tls_mode="${XCIND_PROXY_TLS_MODE:-auto}"

  if [ "$json_mode" = true ]; then
    local assigned_json
    assigned_json=$(__xcind-proxy-status-assigned-json)
    jq -cn \
      --argjson initialized "$initialized" \
      --arg network_name "$XCIND_PROXY_NETWORK" \
      --argjson network_exists "$network_exists" \
      --arg http_entrypoint "$XCIND_PROXY_HTTP_ENTRYPOINT" \
      --arg https_entrypoint "$XCIND_PROXY_HTTPS_ENTRYPOINT" \
      --arg certresolver "$XCIND_PROXY_CERTRESOLVER" \
      --arg tls_mode "$tls_mode" \
      --arg domain "$domain" \
      --arg proxy_container "$proxy_container" \
      --argjson assigned_ports "$assigned_json" \
      '{
        initialized: $initialized,
        mode: "external",
        status: "external",
        network_name: $network_name,
        network_exists: $network_exists,
        http_entrypoint: $http_entrypoint,
        https_entrypoint: $https_entrypoint,
        certresolver: $certresolver,
        tls_mode: $tls_mode,
        domain: $domain,
        proxy_container: $proxy_container,
        assigned_ports: $assigned_ports
      }'
  else
    echo "Status: external"
    echo "Mode: external"
    if [ "$network_exists" = true ]; then
      echo "Network: $XCIND_PROXY_NETWORK (exists)"
    else
      echo "Network: $XCIND_PROXY_NETWORK (missing)"
    fi
    echo "Entrypoints: $XCIND_PROXY_HTTP_ENTRYPOINT / $XCIND_PROXY_HTTPS_ENTRYPOINT"
    echo "Certresolver: ${XCIND_PROXY_CERTRESOLVER:-none}"
    echo "Domain: $domain"
    echo "TLS mode: $tls_mode"
    if [[ -n $proxy_container ]]; then
      echo "Proxy container: $proxy_container (detected)"
    else
      echo "Warning: no proxy-like container detected on network '$XCIND_PROXY_NETWORK'." >&2
    fi
    __xcind-proxy-status-assigned-text
  fi
}

# Render the assigned-ports section of `xcind-proxy status` as plain text.
# Reads the state file directly via __xcind-assigned-iter — callers already
# hold (or have released) the assigned-ports lock; this is a read-only
# snapshot.
__xcind-proxy-status-assigned-text() {
  __xcind_proxy_status_text_any=0
  __xcind-assigned-iter __xcind-proxy-status-assigned-text-row
  unset __xcind_proxy_status_text_any
}

__xcind-proxy-status-assigned-text-row() {
  local L_port="$1" L_workspace="$2" L_application="$3" L_service="$4"
  local L_cport="$5" L_path="$6"
  if [ "$__xcind_proxy_status_text_any" -eq 0 ]; then
    echo ""
    echo "Assigned ports:"
    __xcind_proxy_status_text_any=1
  fi
  local prefix
  if [[ -n $L_workspace ]]; then
    prefix="$L_workspace/$L_application/$L_service"
  else
    prefix="$L_application/$L_service"
  fi
  printf '  %s  %s  → container port %s  (%s)\n' \
    "$L_port" "$prefix" "$L_cport" "$L_path"
}

# Render the assigned-ports section as a JSON array.
__xcind-proxy-status-assigned-json() {
  if ! command -v jq &>/dev/null; then
    echo "[]"
    return 0
  fi
  __xcind_proxy_status_json_result="[]"
  __xcind-assigned-iter __xcind-proxy-status-assigned-json-row
  printf '%s' "$__xcind_proxy_status_json_result"
  unset __xcind_proxy_status_json_result
}

__xcind-proxy-status-assigned-json-row() {
  local L_port="$1" L_workspace="$2" L_application="$3" L_service="$4"
  local L_cport="$5" L_path="$6" L_ts="$7"
  __xcind_proxy_status_json_result=$(printf '%s' "$__xcind_proxy_status_json_result" | jq \
    --argjson port "$L_port" \
    --arg workspace "$L_workspace" \
    --arg application "$L_application" \
    --arg service "$L_service" \
    --argjson cport "$L_cport" \
    --arg path "$L_path" \
    --arg ts "$L_ts" \
    '. + [{host_port: $port, workspace: $workspace, application: $application, service: $service, container_port: $cport, app_path: $path, assigned_at: $ts}]')
}

__xcind-proxy-release() {
  local port="${1:-}"
  if [[ -z $port ]]; then
    echo "Usage: xcind-proxy release <port>" >&2
    exit 1
  fi
  if [[ $# -gt 1 ]]; then
    echo "Error: Unexpected argument for release: $2" >&2
    exit 1
  fi
  if ! [[ $port =~ ^[0-9]+$ ]]; then
    echo "Error: port must be a positive integer, got: $port" >&2
    exit 1
  fi
  local release_rc=0
  __xcind-with-assigned-lock __xcind-assigned-remove-port "$port" || release_rc=$?
  case "$release_rc" in
  0)
    echo "Released assigned port $port"
    ;;
  2)
    echo "Error: release failed — assigned-ports state file left unchanged" >&2
    exit 1
    ;;
  *)
    echo "No assignment found for port $port" >&2
    exit 1
    ;;
  esac
}

__xcind-proxy-prune() {
  if [[ $# -gt 0 ]]; then
    echo "Error: Unexpected argument for prune: $1" >&2
    exit 1
  fi

  local pruned
  if ! pruned=$(__xcind-with-assigned-lock __xcind-assigned-prune); then
    echo "Error: prune failed — assigned-ports state file left unchanged" >&2
    exit 1
  fi
  echo "Pruned $pruned stale assigned port entries"
}

__xcind-proxy-logs() {
  if __xcind-proxy-is-external; then
    local detected=""
    detected=$(__xcind-proxy-detect-external-container) || true
    echo "Error: proxy is externally managed — try: docker logs ${detected:-<your proxy container>}" >&2
    exit 1
  fi

  if [ ! -f "$XCIND_PROXY_COMPOSE" ]; then
    echo "Proxy not initialized. Run 'xcind-proxy init' to set up proxy infrastructure." >&2
    exit 1
  fi

  docker compose -f "$XCIND_PROXY_COMPOSE" logs "$@"
}

# --------------------------------------------------------------------------
# Help
# --------------------------------------------------------------------------

__xcind-proxy-init-help() {
  echo "Usage: xcind-proxy init [OPTIONS]"
  echo ""
  echo "Create proxy infrastructure files (config.sh, compose.yaml, Traefik config)."
  echo ""
  echo "Options:"
  echo "  --mode MODE               Proxy mode: managed, external (default: managed)"
  echo "  --network NAME            Shared proxy Docker network (default: xcind-proxy)"
  echo "  --http-entrypoint NAME    HTTP entrypoint name in router labels (default: web)"
  echo "  --https-entrypoint NAME   HTTPS entrypoint name in router labels (default: websecure)"
  echo "  --certresolver NAME       ACME certresolver added to HTTPS routers (default: none)"
  echo "  --proxy-domain DOMAIN     Set domain suffix (default: localhost.scind.io)"
  echo "  --http-port PORT          Set HTTP port (default: 80)"
  echo "  --image IMAGE             Set Traefik Docker image (default: traefik:v3)"
  echo "  --dashboard BOOL          Enable Traefik dashboard (default: false)"
  echo "  --dashboard-port PORT     Set dashboard port (default: 8080)"
  echo "  --tls-mode MODE           TLS mode: auto, custom, disabled (default: auto)"
  echo "  --https-port PORT         Set HTTPS port (default: 443)"
  echo "  --tls-cert-file PATH      Custom cert file (only used when --tls-mode custom)"
  echo "  --tls-key-file PATH       Custom key file (only used when --tls-mode custom)"
  echo "  --help, -h                Show this help"
  cat <<'HELPEOF'

External mode (--mode external) attaches apps to an existing proxy's
network instead of running a managed Traefik. Example (Coolify host):
  xcind-proxy init --mode external --network coolify \
    --http-entrypoint http --https-entrypoint https --certresolver letsencrypt
HELPEOF
}

__xcind-proxy-help() {
  echo "Usage: xcind-proxy <subcommand>"
  echo ""
  echo "Subcommands:"
  echo "  init [OPTIONS]     Create proxy infrastructure files"
  echo "  dispose [OPTIONS]  Stop proxy and remove generated state"
  echo "  up [--force]       Start the shared Traefik proxy (--force recreates network)"
  echo "  down               Stop the shared Traefik proxy"
  echo "  status [--json]    Show proxy state (running/stopped, image, port, network, assigned ports)"
  echo "  logs [OPTS]        Show Traefik proxy logs (supports docker compose logs flags)"
  echo "  release PORT       Release an assigned port from the state file"
  echo "  prune              Remove assigned-port entries whose app path no longer exists"
  echo ""
  echo "Dispose options:"
  echo "  --purge            Also remove the proxy configuration directory"
  echo "  --yes, -y          Skip the confirmation prompt"
  echo ""
  echo "In external proxy mode (init --mode external), 'up' only verifies the"
  echo "shared network, and 'down'/'logs' refuse — the proxy is not xcind-managed."
  echo ""
  echo "Init options:"
  echo "  --mode MODE               Proxy mode: managed, external (default: managed)"
  echo "  --network NAME            Shared proxy Docker network (default: xcind-proxy)"
  echo "  --http-entrypoint NAME    HTTP entrypoint name in router labels (default: web)"
  echo "  --https-entrypoint NAME   HTTPS entrypoint name in router labels (default: websecure)"
  echo "  --certresolver NAME       ACME certresolver added to HTTPS routers (default: none)"
  echo "  --proxy-domain DOMAIN     Set domain suffix (default: localhost.scind.io)"
  echo "  --http-port PORT          Set HTTP port (default: 80)"
  echo "  --image IMAGE             Set Traefik Docker image (default: traefik:v3)"
  echo "  --dashboard BOOL          Enable Traefik dashboard (default: false)"
  echo "  --dashboard-port PORT     Set dashboard port (default: 8080)"
  echo "  --tls-mode MODE           TLS mode: auto, custom, disabled (default: auto)"
  echo "  --https-port PORT         Set HTTPS port (default: 443)"
  echo "  --tls-cert-file PATH      Custom cert file (only used when --tls-mode custom)"
  echo "  --tls-key-file PATH       Custom key file (only used when --tls-mode custom)"
  echo ""
  echo "Options:"
  echo "  --version, -V  Show version"
  echo "  --help, -h     Show this help"
}

# --------------------------------------------------------------------------
# Dispatch
# --------------------------------------------------------------------------

# Gentle nudge if jq/yq aren't on PATH (silent in scripts and CI). Placed
# after the --version short-circuit and before dispatch so --help still
# prints cleanly.
if [[ ${1:-} != "--help" && ${1:-} != "-h" ]]; then
  __xcind-maybe-warn-deps
fi

# Load the effective proxy config before dispatch so every subcommand sees
# the configured mode and network name — notably `up --force`, which would
# otherwise remove the default network instead of the configured one.
__xcind-proxy-load-config

case "${1:-}" in
init)
  shift
  __xcind-proxy-init "$@"
  ;;
dispose)
  shift
  __xcind-proxy-dispose "$@"
  ;;
up)
  shift
  __xcind-proxy-up "$@"
  ;;
down)
  shift
  __xcind-proxy-down "$@"
  ;;
status)
  shift
  __xcind-proxy-status "$@"
  ;;
logs)
  shift
  __xcind-proxy-logs "$@"
  ;;
release)
  shift
  __xcind-proxy-release "$@"
  ;;
prune)
  shift
  __xcind-proxy-prune "$@"
  ;;
--help | -h)
  __xcind-proxy-help
  exit 0
  ;;
"")
  __xcind-proxy-help
  exit 0
  ;;
*)
  echo "Error: Unknown subcommand '$1'. Run 'xcind-proxy --help' for usage." >&2
  exit 1
  ;;
esac
