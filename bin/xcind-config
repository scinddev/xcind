#!/usr/bin/env bash
# xcind-config — Dump resolved xcind configuration
#
# Usage:
#   xcind-config                                           Show help
#   xcind-config --json                                    JSON output (for JetBrains plugin, scripts)
#   xcind-config --preview [-- ARGS...]                    Show the docker compose command
#   xcind-config --check                                   Check system dependencies
#   xcind-config --generate-docker-wrapper[=FILE]          Generate a POSIX docker wrapper
#   xcind-config --generate-docker-compose-wrapper[=FILE]  Generate a POSIX docker-compose wrapper
#   xcind-config --generate-docker-compose-configuration[=FILE]  Generate resolved compose config
#   xcind-config --generate-starship[=FILE] [--format toml|nix]  Generate Starship [custom.xcind] block (TOML default, or Nix Home Manager attrset)

set -euo pipefail

# Resolve XCIND_ROOT by following symlinks to the real install directory
# (npm, nix profile, and manual symlinks all route through here). macOS
# lacks `readlink -f`, so the resolver is a manual loop.
# Keep in sync with the equivalent stub in the other bin/ scripts.
__xcind_src="${BASH_SOURCE[0]}"
while [ -L "$__xcind_src" ]; do
  __xcind_src_dir=$(cd "$(dirname "$__xcind_src")" && pwd)
  __xcind_src=$(readlink "$__xcind_src")
  [[ $__xcind_src != /* ]] && __xcind_src="$__xcind_src_dir/$__xcind_src"
done
XCIND_ROOT="$(cd "$(dirname "$__xcind_src")/.." && pwd)"
unset __xcind_src __xcind_src_dir
# shellcheck disable=SC1091
source "$XCIND_ROOT/lib/xcind/xcind-bootstrap.bash"

# --- Helpers ---

__xcind_config_usage() {
  cat <<'HELPEOF'
Usage: xcind-config [OPTIONS]
       xcind-config resolve <path> [--cached] [--hooks-ttl=N]

Options:
  --help, -h                            Show this help
  --version, -V                         Show version
  --check                               Check required/optional dependencies
  doctor [--json]                       Diagnose XCIND_PROXY_EXPORTS / assigned-hook state
  resolve <path>                        Get one resolved configuration value
    --cached                            Read current-SHA cache only
    --hooks-ttl=N                       Reuse refreshed cache for N seconds (default: 5)
    --help                              Show resolve paths and path syntax

  --json                                Output resolved config as JSON
  --preview [-- ARGS...]                Show docker compose command

  --generate-docker-wrapper[=FILE]             Generate docker wrapper script
  --generate-docker-compose-wrapper[=FILE]     Generate docker-compose wrapper script
  --generate-docker-compose-configuration[=FILE]  Generate resolved compose config
  --generate-starship[=FILE] [--format toml|nix]  Generate Starship [custom.xcind] block (TOML default, or Nix Home Manager attrset)

  completion {bash|zsh}                        Output shell completion script

Multiple --generate-* flags may be combined when each specifies a file.
Combine with --json to also output JSON to stdout.

Set XCIND_DEBUG=1 to enable trace logging throughout the hook pipeline.
HELPEOF
}

# Detailed help for the `resolve` subcommand. Writes to stdout; callers that
# report a usage error redirect it to stderr.
#
# The "Xcind keys" block is a static copy of the top-level contract built by
# `__xcind-resolve-json` (lib/xcind/xcind-lib.bash). Update both together, plus
# the key list in lib/xcind/xcind-completion-{bash,zsh}.bash.
__xcind_config_resolve_usage() {
  cat <<'HELPEOF'
Usage: xcind-config resolve <path> [--cached] [--hooks-ttl=N]

Options:
  --cached          Read the current-SHA cache only; never run hooks or Docker
  --hooks-ttl=N     Reuse a refreshed cache for N seconds (default: 5, 0 disables)
  --help, -h        Show this help

Path syntax:
  Dotted keys, with an optional leading dot: metadata.app  or  .metadata.app
  Array indexes:                             configFiles[0]
  Keys that contain a dot, double quoted:
    compose.services.web.labels."traefik.http.routers.web.rule"

Xcind keys (top level):
  metadata            .workspace .app .workspaceless
  appRoot
  configFiles[]       composeFiles[]  composeEnvFiles[]
  appEnvFiles[]       bakeFiles[]
  tools
  assignedExports     proxiedExports
  apex                .enabled .hostname .url .scheme

Compose keys (need the resolved cache):
  compose.project.name
  compose.volumes.<key>.name
  compose.networks.<key>.name
  compose.services.<name>.<key>
  ...any key from `docker compose config --format json`
  The bare path `compose` is not resolvable; ask for a path below it.

Output:
  Scalars print raw. Objects and arrays print as compact JSON.

Exit status:
  0 value    1 no value    2 resolved state unavailable    64 usage error
HELPEOF
}

__xcind_config_die() {
  if [[ ${_do_resolve:-false} == true ]]; then
    echo "xcind-config: $1" >&2
    exit 64
  fi
  echo "Error: $1" >&2
  echo "Run 'xcind-config --help' for usage." >&2
  exit 1
}

__xcind_config_claim_stdout() {
  local action="$1"
  if [[ -n $_stdout_claim ]]; then
    __xcind_config_die "cannot combine --${action} (stdout) with --${_stdout_claim} (stdout); specify a file path for one of them"
  fi
  _stdout_claim="$action"
}

# --- Parse arguments ---

_do_help=false
_do_version=false
_do_check=false
_do_doctor=false
_doctor_mode="text"
_do_resolve=false
_resolve_path=""
_resolve_cached=false
_resolve_hooks_ttl_arg=""
_resolve_hooks_ttl_set=false
_do_json=false
_do_preview=false
_do_gen_docker_wrapper=false
_gen_docker_wrapper_file=""
_do_gen_compose_wrapper=false
_gen_compose_wrapper_file=""
_do_gen_compose_config=false
_gen_compose_config_file=""
_do_gen_starship=false
_gen_starship_file=""
_gen_format="toml"
_format_set=false
_do_completion=""
_stdout_claim=""
_action_count=0
PREVIEW_EXTRA_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
  --help | -h)
    # A trailing --help behind a resolve path asks about resolve, not about
    # xcind-config as a whole. Answer that instead of reporting a conflict.
    if [[ $_do_resolve == true ]]; then
      __xcind_config_resolve_usage
      exit 0
    fi
    _do_help=true
    _action_count=$((_action_count + 1))
    ;;
  --version | -V)
    _do_version=true
    _action_count=$((_action_count + 1))
    ;;
  --check)
    _do_check=true
    _action_count=$((_action_count + 1))
    ;;
  --cached)
    _resolve_cached=true
    ;;
  --hooks-ttl=*)
    _resolve_hooks_ttl_arg="${1#*=}"
    _resolve_hooks_ttl_set=true
    ;;
  --json)
    _do_json=true
    _action_count=$((_action_count + 1))
    __xcind_config_claim_stdout "json"
    ;;
  --preview)
    _do_preview=true
    _action_count=$((_action_count + 1))
    __xcind_config_claim_stdout "preview"
    ;;
  --generate-docker-wrapper=*)
    _do_gen_docker_wrapper=true
    _gen_docker_wrapper_file="${1#*=}"
    if [[ -z $_gen_docker_wrapper_file ]]; then
      __xcind_config_die "--generate-docker-wrapper= requires a file path (use --generate-docker-wrapper without = for stdout)"
    fi
    _action_count=$((_action_count + 1))
    ;;
  --generate-docker-wrapper)
    _do_gen_docker_wrapper=true
    # Check if next arg is a value (not a flag)
    if [[ $# -ge 2 && ${2:0:1} != "-" ]]; then
      shift
      _gen_docker_wrapper_file="$1"
    else
      __xcind_config_claim_stdout "generate-docker-wrapper"
    fi
    _action_count=$((_action_count + 1))
    ;;
  --generate-docker-compose-wrapper=*)
    _do_gen_compose_wrapper=true
    _gen_compose_wrapper_file="${1#*=}"
    if [[ -z $_gen_compose_wrapper_file ]]; then
      __xcind_config_die "--generate-docker-compose-wrapper= requires a file path (use --generate-docker-compose-wrapper without = for stdout)"
    fi
    _action_count=$((_action_count + 1))
    ;;
  --generate-docker-compose-wrapper)
    _do_gen_compose_wrapper=true
    # Check if next arg is a value (not a flag)
    if [[ $# -ge 2 && ${2:0:1} != "-" ]]; then
      shift
      _gen_compose_wrapper_file="$1"
    else
      __xcind_config_claim_stdout "generate-docker-compose-wrapper"
    fi
    _action_count=$((_action_count + 1))
    ;;
  --generate-docker-compose-configuration=*)
    _do_gen_compose_config=true
    _gen_compose_config_file="${1#*=}"
    if [[ -z $_gen_compose_config_file ]]; then
      __xcind_config_die "--generate-docker-compose-configuration= requires a file path (use --generate-docker-compose-configuration without = for stdout)"
    fi
    _action_count=$((_action_count + 1))
    ;;
  --generate-docker-compose-configuration)
    _do_gen_compose_config=true
    # Check if next arg is a value (not a flag)
    if [[ $# -ge 2 && ${2:0:1} != "-" ]]; then
      shift
      _gen_compose_config_file="$1"
    else
      __xcind_config_claim_stdout "generate-docker-compose-configuration"
    fi
    _action_count=$((_action_count + 1))
    ;;
  --generate-starship=*)
    _do_gen_starship=true
    _gen_starship_file="${1#*=}"
    if [[ -z $_gen_starship_file ]]; then
      __xcind_config_die "--generate-starship= requires a file path (use --generate-starship without = for stdout)"
    fi
    _action_count=$((_action_count + 1))
    ;;
  --generate-starship)
    _do_gen_starship=true
    # Check if next arg is a value (not a flag)
    if [[ $# -ge 2 && ${2:0:1} != "-" ]]; then
      shift
      _gen_starship_file="$1"
    fi
    _action_count=$((_action_count + 1))
    ;;
  --format=*)
    # Modifier for --generate-starship; deliberately does NOT bump
    # _action_count so the "--generate-starship cannot be combined" check
    # (keyed on _action_count) is preserved.
    _gen_format="${1#*=}"
    _format_set=true
    ;;
  --format)
    # Space form: require a following value (mirror xcind-prompt: exit 2).
    if [[ $# -ge 2 ]]; then
      shift
      _gen_format="$1"
      _format_set=true
    else
      echo "Error: --format requires a value (toml or nix)." >&2
      echo "Run 'xcind-config --help' for usage." >&2
      exit 2
    fi
    ;;
  completion)
    shift
    case "${1:-}" in
    bash) _do_completion="bash" ;;
    zsh) _do_completion="zsh" ;;
    "") __xcind_config_die "completion requires a shell argument: bash or zsh" ;;
    *) __xcind_config_die "unsupported shell: $1 (expected bash or zsh)" ;;
    esac
    _action_count=$((_action_count + 1))
    ;;
  doctor)
    _do_doctor=true
    _action_count=$((_action_count + 1))
    if [[ $# -ge 2 && $2 == "--json" ]]; then
      shift
      _doctor_mode="json"
    fi
    ;;
  resolve)
    # Handle help before claiming stdout, so `resolve --help` can never
    # collide with another action's stdout claim.
    if [[ ${2:-} == "--help" || ${2:-} == "-h" ]]; then
      __xcind_config_resolve_usage
      exit 0
    fi
    _do_resolve=true
    _action_count=$((_action_count + 1))
    if [[ $# -lt 2 ]]; then
      echo "xcind-config: resolve requires a path" >&2
      echo >&2
      __xcind_config_resolve_usage >&2
      exit 64
    fi
    shift
    _resolve_path="$1"
    __xcind_config_claim_stdout "resolve"
    ;;
  --)
    shift
    PREVIEW_EXTRA_ARGS=("$@")
    break
    ;;
  -*)
    __xcind_config_die "unknown option: $1"
    ;;
  *)
    # When --generate-starship is active and no file has been captured yet,
    # treat a trailing positional as the output file. This supports the
    # `--generate-starship --format nix outfile.nix` order, where --format
    # intervenes and the bare arm's adjacency check cannot grab the file.
    # A second positional still errors (the file is then non-empty).
    if [[ $_do_gen_starship == true && -z $_gen_starship_file ]]; then
      _gen_starship_file="$1"
    else
      __xcind_config_die "unexpected argument: $1"
    fi
    ;;
  esac
  shift
done

# --- Post-parse validation ---

# No actions means help
if [[ $_action_count -eq 0 ]]; then
  _do_help=true
fi

# Standalone actions cannot combine with anything
if [[ $_do_help == true && $_action_count -gt 1 ]]; then
  __xcind_config_die "--help cannot be combined with other options"
fi
if [[ $_do_version == true && $_action_count -gt 1 ]]; then
  __xcind_config_die "--version cannot be combined with other options"
fi
if [[ $_do_check == true && $_action_count -gt 1 ]]; then
  __xcind_config_die "--check cannot be combined with other options"
fi
if [[ $_do_doctor == true && $_action_count -gt 1 ]]; then
  __xcind_config_die "doctor cannot be combined with other options"
fi
if [[ $_do_resolve == true && $_action_count -gt 1 ]]; then
  echo "xcind-config: resolve cannot be combined with other actions" >&2
  exit 64
fi
if [[ $_do_preview == true && $_action_count -gt 1 ]]; then
  __xcind_config_die "--preview cannot be combined with other options"
fi
if [[ -n $_do_completion && $_action_count -gt 1 ]]; then
  __xcind_config_die "completion cannot be combined with other options"
fi
if [[ $_do_gen_starship == true && $_action_count -gt 1 ]]; then
  __xcind_config_die "--generate-starship cannot be combined with other options"
fi

# --format is only meaningful as a modifier of --generate-starship (D6).
# Use exit 2 to match the sibling xcind-prompt validator (D5/D6).
if [[ $_format_set == true && $_do_gen_starship != true ]]; then
  echo "Error: --format is only valid with --generate-starship." >&2
  echo "Run 'xcind-config --help' for usage." >&2
  exit 2
fi

if [[ $_resolve_cached == true && $_do_resolve != true ]]; then
  echo "xcind-config: --cached is only valid with resolve" >&2
  exit 64
fi
if [[ $_resolve_hooks_ttl_set == true && $_do_resolve != true ]]; then
  echo "xcind-config: --hooks-ttl is only valid with resolve" >&2
  exit 64
fi

if [[ $_resolve_hooks_ttl_set == true ]]; then
  _resolve_hooks_ttl="$_resolve_hooks_ttl_arg"
else
  _resolve_hooks_ttl="${XCIND_HOOKS_TTL:-5}"
fi
if [[ $_do_resolve == true && ! $_resolve_hooks_ttl =~ ^[0-9]+$ ]]; then
  echo "xcind-config: hooks TTL must be a non-negative integer" >&2
  exit 64
fi

# Validate the --format value (D5): only toml and nix are supported.
if [[ $_gen_format != "toml" && $_gen_format != "nix" ]]; then
  echo "Error: unknown --format value: $_gen_format (expected toml or nix)." >&2
  echo "Run 'xcind-config --help' for usage." >&2
  exit 2
fi

# -- args only valid with --preview
if [[ ${#PREVIEW_EXTRA_ARGS[@]} -gt 0 && $_do_preview != true ]]; then
  __xcind_config_die "extra arguments after -- are only valid with --preview"
fi

# --- Standalone early-exit actions ---

if [[ $_do_help == true ]]; then
  __xcind_config_usage
  exit 0
fi

if [[ $_do_version == true ]]; then
  echo "xcind-config $(__xcind-version-string)"
  exit 0
fi

if [[ $_do_check == true ]]; then
  __xcind-check-deps
  exit $?
fi

if [[ -n $_do_completion ]]; then
  _completion_file="$XCIND_ROOT/lib/xcind/xcind-completion-${_do_completion}.bash"
  if [[ ! -f $_completion_file ]]; then
    __xcind_config_die "completion script not found: $_completion_file"
  fi
  cat "$_completion_file"
  exit 0
fi

# The Starship snippet is static (no resolved app config), so emit it here —
# before __xcind-prepare-app — so it works from any directory.
if [[ $_do_gen_starship == true ]]; then
  # Select the emitter by --format: nix emits the bare Nix attrset, anything
  # else (default toml) keeps the byte-identical TOML block.
  _starship_emitter="__xcind-dump-starship-snippet"
  if [[ $_gen_format == "nix" ]]; then
    _starship_emitter="__xcind-dump-starship-snippet-nix"
  fi
  if [[ -n $_gen_starship_file ]]; then
    "$_starship_emitter" >"$_gen_starship_file"
  else
    "$_starship_emitter"
  fi
  exit 0
fi

# Gentle nudge if jq/yq aren't on PATH (silent in scripts and CI).
__xcind-maybe-warn-deps

if [[ $_do_resolve == true ]]; then
  if ! command -v jq &>/dev/null; then
    echo "xcind-config: jq is required for resolve" >&2
    exit 2
  fi
  # Deliberately not exported: __xcind-prepare-app runs in this shell, and
  # exporting these would let them leak into hooks and child processes.
  # shellcheck disable=SC2034 # read by __xcind-prepare-app in the sourced library
  XCIND_PREPARE_USE_HOOKS_TTL=1
  if [[ $_resolve_hooks_ttl_set == true ]]; then
    # shellcheck disable=SC2034 # read by __xcind-hooks-stamp-fresh
    XCIND_PREPARE_HOOKS_TTL="$_resolve_hooks_ttl"
  fi
  if [[ $_resolve_cached == true ]]; then
    # shellcheck disable=SC2034 # read by __xcind-prepare-app in the sourced library
    XCIND_PREPARE_CACHED_ONLY=1
  fi
fi

# --- Main pipeline (shared with xcind-compose) ---

# Runs in the current shell so XCIND_DOCKER_COMPOSE_OPTS and related
# globals are visible to the action handlers below.
_prepare_rc=0
if [[ $_do_resolve == true && ${XCIND_DEBUG:-0} != 1 ]]; then
  # resolve speaks to scripts, so keep the pipeline quiet — but never when
  # the caller asked for debug output, which __xcind-debug writes to stderr.
  __xcind-prepare-app 2>/dev/null || _prepare_rc=$?
else
  __xcind-prepare-app || _prepare_rc=$?
fi
if [[ $_prepare_rc -ne 0 ]]; then
  if [[ $_do_resolve == true ]]; then
    echo "xcind-config: resolved state unavailable" >&2
    exit 2
  fi
  exit "$_prepare_rc"
fi
app_root="$XCIND_APP_ROOT"

# Append one object key to __xcind_config_path_json, JSON-escaped.
# Quoted segments accept any character, so escaping is mandatory here.
__xcind_config_append_key() {
  local key="$1"
  local encoded
  encoded=$(jq -cn --arg key "$key" '$key') || return 2
  __xcind_config_path_json+="$__xcind_config_path_sep$encoded"
  __xcind_config_path_sep=","
}

# Parse a resolve path into the jq path array __xcind_config_path_json.
#
# Grammar: segment ( "." segment )*, where a segment is a bare key, or a
# double-quoted key that may hold dots, followed by zero or more [N] indexes.
# Bare keys stay restricted so typos fail loudly rather than reaching jq.
#
#   services.web.image
#   configFiles[0]
#   services.web.labels."traefik.http.routers.web.rule"
#
# Returns 64 on a malformed path.
__xcind_config_parse_path() {
  local rest="$1"
  local key indexes index
  local backslash=$'\\'

  __xcind_config_path_json="["
  __xcind_config_path_sep=""

  while [[ -n $rest ]]; do
    if [[ $rest == '"'* ]]; then
      # Quoted key: take everything up to the next unescaped double quote.
      rest="${rest#\"}"
      key=""
      while [[ -n $rest && $rest != '"'* ]]; do
        if [[ ${rest:0:1} == "$backslash" ]]; then
          rest="${rest:1}"
          [[ -n $rest ]] || return 64
          if [[ ${rest:0:1} != '"' && ${rest:0:1} != "$backslash" ]]; then
            return 64
          fi
          key+="${rest:0:1}"
          rest="${rest:1}"
        else
          key+="${rest:0:1}"
          rest="${rest:1}"
        fi
      done
      [[ $rest == '"'* ]] || return 64 # unterminated quote
      rest="${rest#\"}"
    else
      key="${rest%%[.[]*}"
      [[ $key =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]] || return 64
      rest="${rest#"$key"}"
    fi
    __xcind_config_append_key "$key" || return $?

    # Zero or more [N] index suffixes.
    while [[ $rest == \[* ]]; do
      indexes="${rest#\[}"
      index="${indexes%%\]*}"
      [[ $indexes == *\]* && $index =~ ^[0-9]+$ ]] || return 64
      __xcind_config_path_json+="$__xcind_config_path_sep$index"
      __xcind_config_path_sep=","
      rest="${indexes#*\]}"
    done

    # Either the path ends here, or a dot introduces the next segment.
    [[ -z $rest ]] && break
    [[ $rest == .?* ]] || return 64
    rest="${rest#.}"
  done

  __xcind_config_path_json+="]"
}

__xcind_config_resolve() {
  local path="$1"
  local source_file="" compose_mode=false

  if [[ $path == .* ]]; then
    path="${path#.}"
  fi
  if [[ $path == "compose" || $path == "compose." ]]; then
    echo "xcind-config: invalid resolve path: $1" >&2
    return 64
  elif [[ $path == compose.* ]]; then
    compose_mode=true
    path="${path#compose.}"
  fi

  if [[ -z $path && $compose_mode == false ]]; then
    echo "xcind-config: invalid resolve path: $1" >&2
    return 64
  fi
  local _parse_rc=0
  __xcind_config_path_json="[]"
  if [[ -n $path ]]; then
    __xcind_config_parse_path "$path" || _parse_rc=$?
    if [[ $_parse_rc -eq 64 ]]; then
      echo "xcind-config: invalid resolve path: $1" >&2
      return 64
    elif [[ $_parse_rc -ne 0 ]]; then
      echo "xcind-config: failed to parse resolve path" >&2
      return 2
    fi
  fi

  # __xcind-prepare-app only builds a cache when GENERATE hooks are
  # registered. Test that directly: an inherited XCIND_CACHE_DIR from the
  # caller's environment would otherwise look like a usable cache.
  local have_cache=false
  if [[ ${#XCIND_HOOKS_GENERATE[@]} -gt 0 && -n ${XCIND_CACHE_DIR:-} ]]; then
    have_cache=true
  fi

  if [[ $_resolve_cached == true && $have_cache == false ]]; then
    echo "xcind-config: resolved state unavailable" >&2
    return 2
  fi

  if [[ $compose_mode == true ]]; then
    # Compose values live only in the cache, which needs GENERATE hooks.
    if [[ $have_cache == false ]]; then
      echo "xcind-config: compose paths need the resolved cache," \
        "which an empty XCIND_HOOKS_GENERATE disables for this app" >&2
      return 2
    fi
    source_file="$XCIND_CACHE_DIR/resolved-config.json"
    if [[ ! -f $source_file ]]; then
      echo "xcind-config: resolved state unavailable" >&2
      return 2
    fi
  elif [[ $have_cache == true && -f $XCIND_CACHE_DIR/config.json ]]; then
    source_file="$XCIND_CACHE_DIR/config.json"
  fi

  # shellcheck disable=SC2016 # jq program; dollar-prefixed names are jq variables
  local common='
    def emit:
      if type == "array" or type == "object" then tojson else . end;
    def lookup:
      # getpath raises when the path runs through a scalar. Report that as a
      # missing value (exit 1) with a hint, rather than leaking jq exit 5.
      . as $root
      | try ($root | getpath($path) | {found: true, value: .})
        catch {found: false}
      | if .found | not then
          ("xcind-config: path is not traversable: " + $raw + "\n" | halt_error(1))
        elif .value == null then ("" | halt_error(1))
        else .value | emit end;
  '
  local filter="$common"'lookup'
  if [[ $compose_mode == true ]]; then
    # `docker compose config` resolves volume and network names itself, and
    # has done so since 2.6 — the floor this command already requires. So the
    # only view we add is `project`, an alias for the top-level `name`.
    # Deriving names here would be wrong for `external: true` entries, which
    # Compose deliberately leaves un-prefixed.
    # shellcheck disable=SC2016 # jq program; dollar-prefixed names are jq variables
    filter="$common"'
      def compose_view: . + {project: {name: .name}};
      compose_view | lookup
    '
  fi

  local _rc=0
  if [[ -n $source_file ]]; then
    jq -r --arg raw "$1" --argjson path "$__xcind_config_path_json" \
      "$filter" "$source_file" || _rc=$?
  else
    # No cache dir (XCIND_HOOKS_GENERATE is empty), so build the same
    # config.json contract in memory instead of reading it from disk.
    __xcind-resolve-json "$app_root" |
      jq -r --arg raw "$1" --argjson path "$__xcind_config_path_json" "$filter" || _rc=$?
  fi
  # jq exits 1 only via halt_error above; anything else is a read failure.
  if [[ $_rc -gt 1 ]]; then
    echo "xcind-config: failed to read resolved state" >&2
    return 2
  fi
  return "$_rc"
}

# Resolve the xcind bin directory as seen by the current shell.
# This captures the user-facing path (e.g. ~/.nix-profile/bin) rather than
# the symlink-resolved path, so the wrapper works even when the caller's
# PATH does not include the Nix store or other non-standard locations.
__xcind_bin_dir() {
  local xcind_compose_path
  if xcind_compose_path=$(command -v xcind-compose 2>/dev/null); then
    dirname "$xcind_compose_path"
  else
    echo "$XCIND_ROOT/bin"
  fi
}

# --- Execute actions ---

if [[ $_do_resolve == true ]]; then
  _resolve_rc=0
  __xcind_config_resolve "$_resolve_path" || _resolve_rc=$?
  exit "$_resolve_rc"
fi

if [[ $_do_preview == true ]]; then
  __xcind-preview-command "$app_root" "${PREVIEW_EXTRA_ARGS[@]}"
fi

# Resolve the bin dir once: both wrapper generators embed the same path
# and the function forks `command -v` on every call.
_xcind_bin_dir_cached=""
if [[ $_do_gen_docker_wrapper == true || $_do_gen_compose_wrapper == true ]]; then
  _xcind_bin_dir_cached=$(__xcind_bin_dir)
fi

if [[ $_do_gen_docker_wrapper == true ]]; then
  if [[ -n $_gen_docker_wrapper_file ]]; then
    __xcind-dump-docker-wrapper "$app_root" "$_xcind_bin_dir_cached" >"$_gen_docker_wrapper_file"
  else
    __xcind-dump-docker-wrapper "$app_root" "$_xcind_bin_dir_cached"
  fi
fi

if [[ $_do_gen_compose_wrapper == true ]]; then
  if [[ -n $_gen_compose_wrapper_file ]]; then
    __xcind-dump-docker-compose-wrapper "$app_root" "$_xcind_bin_dir_cached" >"$_gen_compose_wrapper_file"
  else
    __xcind-dump-docker-compose-wrapper "$app_root" "$_xcind_bin_dir_cached"
  fi
fi

if [[ $_do_gen_compose_config == true ]]; then
  if [[ -n $_gen_compose_config_file ]]; then
    _tmp_file="${_gen_compose_config_file}.tmp"
    mkdir -p -- "$(dirname "$_gen_compose_config_file")"
    if __xcind-dump-docker-compose-configuration >"$_tmp_file"; then
      mv -- "$_tmp_file" "$_gen_compose_config_file"
    else
      rm -f -- "$_tmp_file"
      exit 1
    fi
  else
    __xcind-dump-docker-compose-configuration
  fi
fi

if [[ $_do_json == true ]]; then
  __xcind-resolve-json "$app_root"
fi

if [[ $_do_doctor == true ]]; then
  if [[ $_doctor_mode == "json" ]]; then
    __xcind-doctor --json
  else
    __xcind-doctor
  fi
fi
